{
  "name": "dependency-checker",
  "display_name": "依赖检查",
  "version": "1.0.0",
  "description": "安全漏洞扫描、过期依赖检测、许可证合规检查",
  "author": "YuanCode",
  "license": "MIT",
  "category": "security",
  "tags": ["security", "dependencies", "vulnerability", "license"],
  "entry": {
    "skills_dir": "skills",
    "main": "dependency-checker"
  },
  "permissions": [
    {
      "name": "network",
      "description": "查询安全漏洞数据库",
      "requires_approval": false
    },
    {
      "name": "file_read",
      "description": "读取依赖配置文件",
      "requires_approval": false
    }
  ],
  "dependencies": [],
  "skills": ["dependency-check", "security-audit"],
  "mcp_servers": [
    {
      "name": "dependency-scanner",
      "command": "dependency-scanner",
      "args": ["--mode", "server"],
      "env": {},
      "timeout_ms": 30000,
      "auto_reconnect": false
    }
  ],
  "commands": [
    {
      "name": "check_deps",
      "description": "检查项目依赖",
      "handler": "dep_check",
      "args": {
        "project_path": "string"
      }
    }
  ],
  "hooks": [
    {
      "event": "on_project_open",
      "handler": "dep_check_on_open"
    }
  ],
  "enabled": true
}