{
  "name": "doc-generator",
  "display_name": "文档生成",
  "version": "1.0.0",
  "description": "API 文档、README、代码注释自动生成",
  "author": "YuanCode",
  "license": "MIT",
  "category": "documentation",
  "tags": ["docs", "api", "readme", "comments"],
  "entry": {
    "skills_dir": "skills",
    "main": "doc-generator"
  },
  "permissions": [
    {
      "name": "file_read",
      "description": "读取项目文件",
      "requires_approval": false
    },
    {
      "name": "file_write",
      "description": "写入文档文件",
      "requires_approval": true
    }
  ],
  "dependencies": [],
  "skills": ["doc-writer"],
  "mcp_servers": [],
  "commands": [
    {
      "name": "generate_docs",
      "description": "生成项目文档",
      "handler": "doc_generate",
      "args": {
        "type": "string",
        "target": "string"
      }
    }
  ],
  "hooks": [],
  "enabled": true
}